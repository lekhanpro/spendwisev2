# Firebase Configuration
# Get these values from your Firebase Console: https://console.firebase.google.com/
# Project Settings > General > Your apps > SDK setup and configuration

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Authentication Setup
# 1. Enable Email/Password authentication in Firebase Console
# 2. Configure email verification and password reset templates
# 3. Add your Vercel domain to authorized domains in Firebase Console

# Investment Module Configuration
VITE_MARKET_DATA_MODE=live
VITE_MARKET_PROVIDER=alpha-vantage
VITE_TWELVE_DATA_API_KEY=
VITE_ALPHA_VANTAGE_API_KEY=
VITE_GNEWS_API_KEY=
VITE_YAHOO_FINANCE_PROXY_URL=
VITE_NSE_PROXY_URL=
VITE_BSE_PROXY_URL=
VITE_SCHEME_DATA_URL=
VITE_MUTUAL_FUND_DATA_URL=
VITE_MARKET_NEWS_URL=

# Groq API Key for AI Chatbot
# Get your free API key from: https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here
